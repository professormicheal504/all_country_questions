                "tag": "b",
                "text": "400 cm\u00b3",
                "is_correct": false
            },
            {
                "option_id": "62470",
                "tag": "c",
                "text": "533 cm\u00b3",
                "is_correct": true
            },
            {
                "option_id": "73891",
