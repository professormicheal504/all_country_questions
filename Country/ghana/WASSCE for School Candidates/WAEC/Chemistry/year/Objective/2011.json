                "option_id": "37295",
                "tag": "b",
                "text": "Shifts to the right",
                "is_correct": true
            },
            {
                "option_id": "37296",
                "tag": "c",
                "text": "No effect",
                "is_correct": false
            },
            {
                "option_id": "37297",
                "tag": "d",
                "text": "Increases the rate of the reverse reaction",
                "is_correct": false
