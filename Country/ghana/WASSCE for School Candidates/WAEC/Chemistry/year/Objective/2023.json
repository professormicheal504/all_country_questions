        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "71484",
                "tag": "a",
                "text": "$P_1V_1 = P_2V_2$",
                "is_correct": true
            },
            {
                "option_id": "51874",
                "tag": "b",
                "text": "$\\frac{P_1}{V_1} = \\frac{P_2}{V_2}$",
                "is_correct": false
            },
            {
                "option_id": "36688",
                "tag": "c",
                "text": "$P_1 + V_1 = P_2 + V_2$",
                "is_correct": false
            },
            {
                "option_id": "29855",
                "tag": "d",
                "text": "$\\frac{V_1}{P_1} = \\frac{V_2}{P_2}$",
                "is_correct": false
            }
        ],
        "_page_num": 1,
        "_page_idx": 4
    },
