        "exam_type": "WAEC",
        "subject": "Financial Accounting",
        "topic": "Bank Reconciliation",
        "question_type": "Objective",
        "exam_year": "2001",
        "question_text": "<p>A cheque issued for $1,000 was recorded in the cash book as $100. What is the effect on the bank reconciliation statement?</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The cash book balance is <b>understated</b> by $900 ($1,000 - $100). To reconcile, $900 must be <b>added</b> to the cash book balance.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "20935",
                "tag": "a",
