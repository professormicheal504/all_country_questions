                "is_correct": true
            },
            {
                "option_id": "59486",
                "tag": "b",
                "text": "Deduct $900 from the cash book balance",
                "is_correct": false
            },
            {
                "option_id": "46714",
                "tag": "c",
                "text": "Add $1,000 to the bank statement balance",
                "is_correct": false
            },
            {
                "option_id": "99011",
                "tag": "d",
                "text": "Deduct $1,000 from the bank statement balance",
