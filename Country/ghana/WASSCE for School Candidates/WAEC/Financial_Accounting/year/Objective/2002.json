        "topic": "Financial Ratios",
        "question_type": "Objective",
        "exam_year": "2002",
        "question_text": "<p>The formula for calculating the <b>current ratio</b> is:</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The <b>current ratio</b> measures liquidity and is calculated as: <br><center>$\\text{Current Ratio} = \\frac{\\text{Current Assets}}{\\text{Current Liabilities}}$</center></p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "90676",
                "tag": "a",
                "text": "$\\frac{\\text{Current Assets}}{\\text{Total Assets}}$",
                "is_correct": false
            },
            {
                "option_id": "57727",
                "tag": "b",
                "text": "$\\frac{\\text{Current Assets}}{\\text{Current Liabilities}}$",
                "is_correct": true
            },
            {
                "option_id": "28554",
                "tag": "c",
