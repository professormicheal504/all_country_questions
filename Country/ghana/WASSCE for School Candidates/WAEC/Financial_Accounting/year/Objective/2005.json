    "96833": {
        "order_id": 10,
        "exam_type": "WAEC",
        "subject": "Financial Accounting",
        "topic": "Financial Ratios",
        "question_type": "Objective",
        "exam_year": "2005",
        "question_text": "<p>The formula for calculating the <b>Current Ratio</b> is:</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The <b>Current Ratio</b> measures liquidity and is calculated as: <br><b>Current Ratio = Current Assets / Current Liabilities</b>. It indicates a company's ability to pay short-term obligations.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "38919",
                "tag": "a",
                "text": "$\\frac{\\text{Current Assets}}{\\text{Total Assets}}$",
                "is_correct": false
            },
            {
                "option_id": "92479",
                "tag": "b",
                "text": "$\\frac{\\text{Current Assets}}{\\text{Current Liabilities}}$",
                "is_correct": true
            },
            {
                "option_id": "61745",
                "tag": "c",
                "text": "$\\frac{\\text{Net Profit}}{\\text{Sales}}$",
                "is_correct": false
            },
