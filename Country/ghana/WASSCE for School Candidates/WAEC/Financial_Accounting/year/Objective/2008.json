        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The <b>Current Ratio</b> measures liquidity and is calculated as:<br><b>Current Ratio = Current Assets / Current Liabilities</b>. It indicates a company's ability to pay short-term obligations.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
