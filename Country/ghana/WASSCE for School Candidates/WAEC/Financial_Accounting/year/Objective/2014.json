        "exam_type": "WAEC",
        "subject": "Financial Accounting",
        "topic": "Financial Ratios",
        "question_type": "Objective",
        "exam_year": "2014",
        "question_text": "<p>The formula for calculating the <b>current ratio</b> is:</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The <b>Current Ratio</b> measures liquidity and is calculated as: <br><b>$Current Ratio = \\frac{Current Assets}{Current Liabilities}$</b>.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "82132",
                "tag": "a",
                "text": "$\\frac{Current Assets}{Total Assets}$",
                "is_correct": false
            },
            {
                "option_id": "84062",
                "tag": "b",
                "text": "$\\frac{Current Assets}{Current Liabilities}$",
                "is_correct": true
            },
            {
                "option_id": "69750",
                "tag": "c",
                "text": "$\\frac{Total Assets}{Total Liabilities}$",
                "is_correct": false
            },
