        "topic": "Financial Ratios",
        "question_type": "Objective",
        "exam_year": "2015",
        "question_text": "<p>The current ratio is calculated as:</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The current ratio measures a company's ability to pay its short-term obligations with its current assets. It is calculated as: $Current\\ Ratio = \\frac{Current\\ Assets}{Current\\ Liabilities}$.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "53277",
                "tag": "a",
                "text": "$\\frac{Current\\ Liabilities}{Current\\ Assets}$",
                "is_correct": false
            },
            {
                "option_id": "31658",
                "tag": "b",
                "text": "$\\frac{Current\\ Assets}{Current\\ Liabilities}$",
                "is_correct": true
            },
            {
                "option_id": "51982",
                "tag": "c",
                "text": "$\\frac{Total\\ Assets}{Total\\ Liabilities}$",
                "is_correct": false
            },
            {
                "option_id": "79524",
