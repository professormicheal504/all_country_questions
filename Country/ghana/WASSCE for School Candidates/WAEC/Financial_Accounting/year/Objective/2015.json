        "question_type": "Objective",
        "exam_year": "2015",
        "question_text": "<p>Which of the following correctly represents the accounting equation?</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The accounting equation is the foundation of double-entry bookkeeping. It states that the total assets of a business are equal to the total liabilities plus the owner's equity. This is represented as: $Assets = Liabilities + Owner's\\ Equity$.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "53268",
                "tag": "a",
                "text": "$Assets = Liabilities - Owner's\\ Equity$",
                "is_correct": false
            },
            {
                "option_id": "31649",
                "tag": "b",
                "text": "$Assets = Liabilities + Owner's\\ Equity$",
                "is_correct": true
            },
            {
                "option_id": "51973",
                "tag": "c",
                "text": "$Assets + Liabilities = Owner's\\ Equity$",
                "is_correct": false
            },
            {
                "option_id": "79515",
                "tag": "d",
                "text": "$Assets - Liabilities = Owner's\\ Equity - Profit$",
                "is_correct": false
            }
        ],
