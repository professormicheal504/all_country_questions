    "44493": {
        "order_id": 9,
        "exam_type": "WAEC",
        "subject": "Financial Accounting",
        "topic": "Financial Ratios",
        "question_type": "Objective",
        "exam_year": "2017",
        "question_text": "<p>The formula for calculating the <b>current ratio</b> is:</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The <b>current ratio</b> measures liquidity and is calculated as: <b>$Current\thinspace Ratio = \frac{Current\thinspace Assets}{Current\thinspace Liabilities}$</b>.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "74045",
                "tag": "a",
                "text": "$\frac{Current\thinspace Assets}{Total\thinspace Assets}$",
                "is_correct": false
            },
            {
                "option_id": "63172",
                "tag": "b",
                "text": "$\frac{Current\thinspace Assets}{Current\thinspace Liabilities}$",
                "is_correct": true
            },
            {
                "option_id": "33244",
                "tag": "c",
                "text": "$\frac{Total\thinspace Assets}{Total\thinspace Liabilities}$",
                "is_correct": false
            },
            {
                "option_id": "60052",
                "tag": "d",
                "text": "$\frac{Current\thinspace Liabilities}{Current\thinspace Assets}$",
                "is_correct": false
            }
        ],
