    "24742": {
        "order_id": 6,
        "exam_type": "WAEC",
        "subject": "Financial Accounting",
        "topic": "Bank Reconciliation",
        "question_type": "Objective",
        "exam_year": "2018",
        "question_text": "<p>A cheque issued for $1,000 was recorded in the cash book as $100. What is the effect on the bank reconciliation statement?</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>The cash book balance is <b>understated</b> by $900 ($1,000 - $100). To reconcile, the cash book balance must be <b>increased by $900</b>.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "39305",
                "tag": "a",
                "text": "Increase cash book balance by $900",
                "is_correct": true
            },
            {
                "option_id": "63366",
                "tag": "b",
                "text": "Decrease cash book balance by $900",
                "is_correct": false
            },
            {
                "option_id": "31061",
                "tag": "c",
                "text": "Increase bank statement balance by $900",
                "is_correct": false
            },
            {
                "option_id": "93377",
                "tag": "d",
                "text": "No effect on the cash book balance",
                "is_correct": false
