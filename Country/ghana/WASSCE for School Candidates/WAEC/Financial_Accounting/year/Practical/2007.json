        "topic": "Depreciation Methods",
        "question_type": "Practical",
        "exam_year": "2007",
        "question_text": "<p>A machine was purchased for \u20b550,000 with an estimated useful life of 5 years and a residual value of \u20b55,000. Calculate the annual depreciation charge using the straight-line method.</p>",
        "question_image": null,
        "answer_image": null,
