    "51731": {
        "order_id": 2,
        "exam_type": "WAEC",
        "subject": "Financial Accounting",
        "topic": "Double-Entry Rules",
        "question_type": "Practical",
        "exam_year": "2010",
        "question_text": "<p>A business purchased goods for \u20b58,000 on credit. Which of the following entries correctly records this transaction?</p>",
        "question_image": null,
        "answer_image": null,
        "explanation": "<p>Under double-entry rules, a purchase of goods on credit increases the <b>Purchases Account (Debit)</b> and increases the <b>Creditors Account (Credit)</b>.<br>The correct entry is:<br><b>Debit Purchases \u20b58,000<br>Credit Creditors \u20b58,000</b>.</p>",
        "reference_passage": null,
        "novel": null,
        "comments_count": 0,
        "options": [
            {
                "option_id": "24082",
                "tag": "a",
                "text": "Debit Cash \u20b58,000, Credit Purchases \u20b58,000",
                "is_correct": false
            },
            {
                "option_id": "97214",
                "tag": "b",
                "text": "Debit Purchases \u20b58,000, Credit Creditors \u20b58,000",
                "is_correct": true
            },
            {
                "option_id": "33773",
                "tag": "c",
                "text": "Debit Creditors \u20b58,000, Credit Purchases \u20b58,000",
                "is_correct": false
            },
            {
                "option_id": "49334",
                "tag": "d",
                "text": "Debit Purchases \u20b58,000, Credit Cash \u20b58,000",
                "is_correct": false
            }
        ],
        "_page_num": 1,
