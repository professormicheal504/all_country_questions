            {
                "option_id": "29521",
                "tag": "b",
                "text": "Hardship is difficult but does not destroy everyone.",
                "is_correct": true
            },
            {
                "option_id": "13378",
                "tag": "c",
                "text": "Hunger is a blessing in disguise.",
                "is_correct": false
