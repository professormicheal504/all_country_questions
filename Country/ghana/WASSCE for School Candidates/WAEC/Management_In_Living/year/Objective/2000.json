                "is_correct": false
            },
            {
                "option_id": "14582",
                "tag": "b",
                "text": "The value of the next best alternative that is given up when making a choice.",
                "is_correct": true
            },
            {
                "option_id": "33094",
                "tag": "c",
                "text": "The cost of resources that are wasted.",
                "is_correct": false
