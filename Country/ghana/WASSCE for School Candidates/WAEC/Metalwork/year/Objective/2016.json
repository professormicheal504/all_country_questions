                "tag": "b",
                "text": "Carbon monoxide ($CO$)",
                "is_correct": true
            },
            {
                "option_id": "75824",
                "tag": "c",
                "text": "Hydrogen ($H_2$)",
                "is_correct": false
            },
            {
                "option_id": "78879",
