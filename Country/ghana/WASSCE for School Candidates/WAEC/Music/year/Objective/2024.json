            "15695': {\n        \"order_id\": 26,\n        \"exam_type\": \"WAEC\",\n        \"subject\": \"Music\",\n        \"topic\": \"Cadence Types\",\n        \"question_type\": \"Objective\",\n        \"exam_year\": \"2024\",\n        \"question_text\": \"<p>Which cadence is described as <b>\"sounding complete and final\"</b>?</p>\",\n        \"question_image\": null,\n        \"answer_image\": null,\n        \"explanation\": \"<p>A <b>perfect cadence</b> (V-I) is described as sounding complete and final. It is one of the most conclusive cadences in Western harmony, as outlined in the WAEC syllabus.</p>\",\n        \"reference_passage\": null,\n        \"novel\": null,\n        \"comments_count\": 0,\n        \"options\": [\n            { \"option_id\": \"87820\", \"tag\": \"a\", \"text\": \"Plagal cadence\", \"is_correct\": false },\n            { \"option_id\": \"47441\", \"tag\": \"b\", \"text\": \"Perfect cadence\", \"is_correct\": true },\n            { \"option_id\": \"86581\", \"tag\": \"c\", \"text\": \"Imperfect cadence\", \"is_correct\": false },\n            { \"option_id\": \"67963\", \"tag\": \"d\", \"text\": \"Deceptive cadence\", \"is_correct\": false }\n        ],\n        \"_page_num\": 1,\n        \"_page_idx\": 1\n    },\n    \"15696\": {\n        \"order_id\": 27,\n        \"exam_type\": \"WAEC\",\n        \"subject\": \"Music\",\n        \"topic\": \"African Music Traits\",\n        \"question_type\": \"Objective\",\n        \"exam_year\": \"2024\",\n        \"question_text\": \"<p>Which of the following is a <b>key characteristic</b> of African traditional music?</p>\",\n        \"question_image\": null,\n        \"answer_image\": null,\n        \"explanation\": \"<p><b>Call-and-response</b> is a key characteristic of African traditional music. It involves a leader singing or playing a phrase, followed by a group response, reflecting communal participation, a core trait in African music as per the WAEC syllabus.</p>\",\n        \"reference_passage\": null,\n        \"novel\": null,\n        \"comments_count\": 0,\n        \"options\": [\n            { \"option_id\": \"87821\", \"tag\": \"a\", \"text\": \"Strict adherence to written notation\", \"is_correct\": false },\n            { \"option_id\": \"47442\", \"tag\": \"b\", \"text\": \"Call-and-response\", \"is_correct\": true },\n            { \"option_id\": \"86582\", \"tag\": \"c\", \"text\": \"Use of only Western instruments\", \"is_correct\": false },\n            { \"option_id\": \"67964\", \"tag\": \"d\", \"text\": \"Absence of rhythm\", \"is_correct\": false }\n        ],\n        \"_page_num\": 1,\n        \"_page_idx\": 1\n    },\n    \"15697\": {\n        \"order_id\": 28,\n        \"exam_type\": \"WAEC\",\n        \"subject\": \"Music\",\n        \"topic\": \"Ghanaian Traditional Music\",\n        \"question_type\": \"Objective\",\n        \"exam_year\": \"2024\",\n        \"question_text\": \"<p>Which Ghanaian traditional music genre is associated with the <b>Akan</b> people and features <i>fontomfrom</i> drums?</p>\",\n        \"question_image\": null,\n        \"answer_image\": null,\n        \"explanation\": \"<p><b>Adowa</b> is a Ghanaian traditional music genre associated with the Akan people and often features <i>fontomfrom</i> drums. It is performed during social gatherings and ceremonies, as highlighted in the WAEC syllabus.</p>\",\n        \"reference_passage\": null,\n        \"novel\": null,\n        \"comments_count\": 0,\n        \"options\": [\n            { \"option_id\": \"87822\", \"tag\": \"a\", \"text\": \"Kpanlogo\", \"is_correct\": false },\n            { \"option_id\": \"47443\", \"tag\": \"b\", \"text\": \"Adowa\", \"is_correct\": true },\n            { \"option_id\": \"86583\", \"tag\": \"c\", \"text\": \"Agbadza\", \"is_correct\": false },\n            { \"option_id\": \"67965\", \"tag\": \"d\", \"text\": \"Bawa\", \"is_correct\": false }\n        ],\n        \"_page_num\": 1,\n        \"_page_idx\": 1\n    },\n    \"15698\": {\n        \"order_id\": 29,\n        \"exam_type\": \"WAEC\",\n        \"subject\": \"Music\",\n        \"topic\": \"Western Art Music Periods\",\n        \"question_type\": \"Objective\",\n        \"exam_year\": \"2024\",\n        \"question_text\": \"<p>Which period of Western art music is characterized by <b>ornate melodies, contrast, and the use of basso continuo</b>?</p>\",\n        \"question_image\": null,\n        \"answer_image\": null,\n        \"explanation\": \"<p>The <b>Baroque period</b> (1600\u20131750) is characterized by ornate melodies, contrast, and the use of <i>basso continuo</i>. Composers like J.S. Bach and Handel are prominent figures of this era, as per the WAEC syllabus.</p>\",\n        \"reference_passage\": null,\n        \"novel\": null,\n        \"comments_count\": 0,\n        \"options\": [\n            { \"option_id\": \"87823\", \"tag\": \"a\", \"text\": \"Renaissance\", \"is_correct\": false },\n            { \"option_id\": \"47444\", \"tag\": \"b\", \"text\": \"Baroque\", \"is_correct\": true },\n            { \"option_id\": \"86584\", \"tag\": \"c\", \"text\": \"Classical\", \"is_correct\": false },\n            { \"option_id\": \"67966\", \"tag\": \"d\", \"text\": \"Romantic\", \"is_correct\": false }\n        ],\n        \"_page_num\": 1,\n        \"_page_idx\": 1\n    },\n    \"15699\": {\n        \"order_id\": 30,\n        \"exam_type\": \"WAEC\",\n        \"subject\": \"Music\",\n        \"topic\": \"Music Technology Tools\",\n        \"question_type\": \"Objective\",\n        \"exam_year\": \"2024\",\n        \"question_text\": \"<p>Which software is primarily used for <b>digital audio workstation (DAW)</b> tasks such as recording, editing, and mixing music?</p>\",\n        \"question_image\": null,\n        \"answer_image\": null,\n        \"explanation\": \"<p><b>Pro Tools</b> is a widely used digital audio workstation (DAW) for recording, editing, and mixing music. It is a standard tool in music production, as outlined in the WAEC syllabus under music technology.</p>\",\n        \"reference_passage\": null,\n        \"novel\": null,\n        \"comments_count\": 0,\n        \"options\": [\n            { \"option_id\": \"87824\", \"tag\": \"a\", \"text\": \"Photoshop\", \"is_correct\": false },\n            { \"option_id\": \"47445\", \"tag\": \"b\", \"text\": \"Pro Tools\", \"is_correct\": true },\n            { \"option_id\": \"86585\", \"tag\": \"c\", \"text\": \"AutoCAD\", \"is_correct\": false },\n            { \"option_id\": \"67967\", \"tag\": \"d\", \"text\": \"Excel\", \"is_correct\": false }\n        ],\n        \"_page_num\": 1,\n        \"_page_idx\": 1\n    }\n}"
