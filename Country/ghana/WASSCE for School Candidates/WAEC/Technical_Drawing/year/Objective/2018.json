                "is_correct": false
            },
            {
                "option_id": "85842",
                "tag": "b",
                "text": "Join the intersection points of the arcs",
                "is_correct": false
            },
            {
                "option_id": "84767",
                "tag": "c",
                "text": "Draw a perpendicular from the midpoint of AB",
