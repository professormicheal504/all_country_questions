                "text": "They have vessels (pores) in their structure.",
                "is_correct": true
            },
            {
                "option_id": "31205",
                "tag": "c",
                "text": "They grow faster than softwoods.",
                "is_correct": false
            },
            {
                "option_id": "64647",
